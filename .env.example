# ============================================================
# CreatorLog — Environment Variables
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to git.
# ============================================================

# ─── Supabase ──────────────────────────────────────────────
# Get these from your Supabase project settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ─── Google Sign In (SSO) ──────────────────────────────────
# OAuth client IDs from Google Cloud Console → Credentials.
# Web client ID is required (used as the audience by Supabase); iOS client ID
# is needed for the native iOS flow. Also set the iOS client's reversed id as
# the iosUrlScheme in app.json, and add all client IDs to the Supabase
# dashboard's Google provider "Authorized Client IDs".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxx.apps.googleusercontent.com

# ─── RevenueCat (subscriptions) ────────────────────────────
REVENUECAT_APPLE_API_KEY=appl_xxxxx
REVENUECAT_GOOGLE_API_KEY=goog_xxxxx

# ─── Sentry (error tracking) ───────────────────────────────
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ─── PostHog (analytics) ───────────────────────────────────
POSTHOG_API_KEY=phc_xxxxx
POSTHOG_HOST=https://app.posthog.com
